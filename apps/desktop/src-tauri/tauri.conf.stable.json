{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Session Echo",
  "mainBinaryName": "anarlog",
  "identifier": "de.flagbit.sessionecho",
  "bundle": {
    "icon": [
      "icons/stable/32x32.png",
      "icons/stable/128x128.png",
      "icons/stable/128x128@2x.png",
      "icons/stable/icon.icns",
      "icons/stable/icon.ico"
    ],
    "linux": {
      "deb": {
        "provides": ["char"],
        "conflicts": ["char"],
        "replaces": ["char"]
      }
    },
    "macOS": {
      "files": {
        "Resources/AppIcon.icns": "resources/stable/AppIcon.icns"
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["sessionecho"] }
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://updates.sessionecho.flagbit.de/stable/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
